# Copy this file to .env and fill in the values you need:
#   PowerShell:  Copy-Item .env.example .env
#
# backend/.env is git-ignored; .env.example is safe to commit.

# --- Supabase (optional in development) -------------------------------------
# Project Settings -> API -> Project URL
SUPABASE_URL=
# Project Settings -> API -> service_role key (eyJ...) or Secret key (sb_secret_...)
# WARNING: the service role bypasses Row Level Security. Server-side only.
SUPABASE_SERVICE_KEY=
# Optional; the API itself does not need the anon key
SUPABASE_ANON_KEY=
# Project Settings -> Database -> Connection string -> URI (only used by scripts/init_db.py)
SUPABASE_DB_URL=

# --- Database mode ----------------------------------------------------------
# auto     = Supabase when configured, otherwise the local SQLite dev database
# supabase = require Supabase (DB routes return 503 until configured)
# local    = always use the local SQLite dev database
DATABASE_MODE=auto
# Where the local database file lives (default: backend/.local/agritech.db)
# LOCAL_DB_PATH=

# --- Auth -------------------------------------------------------------------
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- AI Plant Doctor --------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# true = return a clearly labelled demo report when GEMINI_API_KEY is empty
PLANT_DOCTOR_MOCK=false

# --- App --------------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated list of allowed origins, or * for any
CORS_ORIGINS=*
# Serve index.html/script.js from FastAPI on the same origin
SERVE_FRONTEND=true
